PORT=8080
DATABASE_URL=postgres://cl3:change-this-local-password@db:5432/cl3

# Better Auth
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Used only when the Better Auth user table is empty. The first account is created as owner.
BETTER_AUTH_OWNER_EMAIL=owner@example.com
BETTER_AUTH_OWNER_PASSWORD=replace-with-a-strong-password
BETTER_AUTH_OWNER_NAME=Owner

# 32 random bytes encoded as 64 hexadecimal characters. Keep stable after first deployment.
CREDENTIAL_MASTER_KEY=replace-with-64-hex-characters

# Comma-separated dashboard origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000
